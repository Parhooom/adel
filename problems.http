### Submit C solution for Find Maximum (Problem 3)
POST http://localhost:8080/submissions
Content-Type: application/json

{
  "problem_id": 3,
  "code": "#include <stdio.h>\nint main() {\n    int n, i, num, max = -1000000;\n    scanf(\"%d\", &n);\n    \n    for (i = 0; i < n; i++) {\n        scanf(\"%d\", &num);\n        if (num > max) {\n            max = num;\n        }\n    }\n    \n    printf(\"%d\\n\", max);\n    return 0;\n}",
  "language": "c"
}

